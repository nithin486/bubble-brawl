{
  // Bubble Brawl on Cloudflare Workers (static assets only — the game needs no server code yet).
  // Deploy: npm run deploy   (needs `npx wrangler login` once, or CLOUDFLARE_API_TOKEN)
  "name": "bubble-brawl",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
